# Modelo do .env do TechDigest. Copie para .env (cp .env.example .env) e preencha o que for seu.
#
# Cada chave é um campo de Settings em src/techdigest/config.py: o nome da variável é o do campo em maiúsculas
# (max_news → MAX_NEWS). As linhas comentadas mostram o padrão do código; só descomente o que quiser mudar.
# Os caminhos não trazem valor: o padrão é calculado pelo código (dito no comentário). Para trocar um, escreva um
# caminho absoluto; o .env não expande "~" nem variáveis.
# O ambiente vale mais que o .env, e cada módulo lê a configuração ao ser importado: uma troca em tempo de execução
# precisa estar no ambiente antes do import.

# --- Entrega (Telegram) -------------------------------------------------------------------------------------------
# O token do bot (BotFather) e o id do chat que recebe as notícias. Obrigatórios para a execução real.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# DELIVERY_CHANNEL=telegram          # "arquivo" é o canal da simulação (techdigest --simular); e-mail não existe
# TELEGRAM_TENTATIVAS_AUDIO=3        # tentativas de upload do áudio em falha de rede (o texto não é reenviado)
# TELEGRAM_PAUSA_S=10                # pausa entre essas tentativas
# TELEGRAM_FORCAR_IPV4=true          # a rota IPv6 até o Telegram pode travar o upload
# ARQUIVO_DIR=                       # padrão: data/entregas do repositório, onde o canal "arquivo" grava

# --- LLM ----------------------------------------------------------------------------------------------------------
# LLM_PROVIDER=ollama                # "ollama" usa o servidor local; qualquer outro valor usa um endpoint compatível com OpenAI
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma4:26b
# OLLAMA_NUM_CTX=8192                # a janela do modelo: o orçamento de entrada e os testes partem dela
# OLLAMA_NUM_PREDICT=4096
# OLLAMA_TEMPERATURE=0.5
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_THINK=                      # vazio = padrão do modelo; "true"/"false" liga ou desliga o raciocínio
# OLLAMA_LOG=                        # padrão: $XDG_STATE_HOME/techdigest/ollama_serve.log (sem a variável,
#                                    # ~/.local/state/techdigest/), a saída da ollama.service que a conferência da GPU lê
# TOKENS_FIXOS=                      # padrão: tokens_fixos.json na mesma pasta
#
# Com LLM_PROVIDER diferente de "ollama" (Groq, OpenRouter e outros compatíveis com OpenAI):
# OPENAI_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                   # ex.: https://api.groq.com/openai/v1
# OPENAI_REASONING_EFFORT=           # ex.: low, medium, high, para modelos de raciocínio
#
# LLM_MAX_TOKENS=153600
# LLM_MAX_PROMPT_CHARS=4096
# LLM_RESERVA_SAIDA=3000             # tokens da janela guardados para a resposta (vale o menor entre isto e OLLAMA_NUM_PREDICT)

# --- Coleta e pipeline ----------------------------------------------------------------------------------------------
# Os feeds ficam em config/feeds.txt. RSS_FEEDS (separado por vírgula), se definido, vale no lugar do arquivo,
# MESMO VAZIO: um "RSS_FEEDS=" sem valor deixa a coleta sem nenhum feed. Deixe a linha comentada.
# RSS_FEEDS=
# MAX_NEWS=20                        # notícias entregues por execução
# MAX_POR_FEED=15                    # entradas lidas por feed
# MAX_IDADE_DIAS=7                   # só notícias publicadas há no máximo N dias (0 = sem limite)
# MIN_TEXTO_CHARS=1200               # abaixo disso o item é descartado (manchete sozinha não vira episódio)
# FEED_TIMEOUT_S=30
# FEED_TENTATIVAS=4                  # só erro de rede, tempo esgotado e 408/429/5xx repetem
# FEED_ESPERA_S=20                   # dobra a cada rodada de novas tentativas (20, 40, 80)
# GNEWS_RESOLVER=true                # resolve os links do Google Notícias para a URL do veículo
# MAX_RUNTIME_MIN=180                # nenhum item novo começa depois disso (0 = sem limite); a unit mata em 4 h
# MAX_FALHAS_ENTREGA=3               # falhas de entrega seguidas que encerram a execução
# MAX_REPROVACOES=2                  # execuções reprovadas pelo QA até o item ser abandonado
# EXECUCOES_DIR=                     # padrão: data/execucoes do repositório
# EXECUCOES_DIAS=30                  # dias que o registro de cada execução fica guardado (0 = todos)
# DB_PATH=                           # padrão: data/digest.db do repositório (as notícias vistas)
# AUDIO_DIR=                         # padrão: data/audio do repositório
# EXTRACAO_WORKERS=6                 # extração em lote (só com o agrupamento ligado)
# EXTRACAO_WORKERS_GNEWS=2

# --- Agrupamento e disputa (desligados em produção; ligar é decisão do dono) ----------------------------------------
# AGRUPAMENTO_ATIVO=false
# AGRUP_CHARS_TEXTO=1500
# AGRUP_PESO_TITULO=0.4
# AGRUP_LIMIAR=0.18
# AGRUP_LIMIAR_DUPLICATA=0.95
# AGRUP_MAX_ARTIGOS=3
# AGRUP_MAX_PROVISORIA=6
# AGRUP_CHARS_ETAPA3=900
# DISPUTA_FONTE_UNICA=false

# --- Limites do QA editorial ----------------------------------------------------------------------------------------
# QA_MIN_POR_PERSONAGEM=240
# QA_MIN_HELENA_COM_DEBATE=180
# QA_MIN_LADO_FINO=120
# QA_MAX_LADO_FINO=200               # só diagnóstico: o QA não cobra
# QA_MAX_POR_PERSONAGEM=650
# QA_MIN_TOTAL=600
# QA_MAX_TOTAL=1300
# QA_MIN_FRASES=7
# QA_MAX_FRASES=10

# --- Logging --------------------------------------------------------------------------------------------------------
# LOG_LEVEL=INFO                     # o console; o arquivo data/logs/techdigest.log grava sempre em DEBUG
# LOG_DIR=                           # padrão: data/logs do repositório

# --- E-mail (inacabado: delivery/email_smtp.py não envia nada) ------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_TO=
